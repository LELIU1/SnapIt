<Window x:Class="SnapIt.Windows.DesktopIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="SnapIt 桌面提示" Width="76" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" ToolTip="SnapIt 已运行 · 点击截图 · 拖动右侧握柄移动">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="立即截图" Click="Capture_Click"/>
            <MenuItem Header="帮助与快捷键" Click="Help_Click"/>
            <Separator/>
            <MenuItem Header="隐藏桌面提示图标" Click="Hide_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border Background="#F7FFFFFF" BorderBrush="#D0D8E2" BorderThickness="1"
            CornerRadius="12" Padding="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CaptureButton" Grid.Column="0" Click="Capture_Click" Background="Transparent" BorderThickness="0"
                    Padding="2" Cursor="Hand" ToolTip="点击开始截图"
                    AutomationProperties.Name="SnapIt 截图">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="21" Height="21" Margin="0,0,4,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,7 C3,5.9 3.9,5 5,5 H8 L9.5,3 H14.5 L16,5 H19 C20.1,5 21,5.9 21,7 V18 C21,19.1 20.1,20 19,20 H5 C3.9,20 3,19.1 3,18 Z"
                                  Fill="#07C160"/>
                            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="White"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#07C160"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="截屏" FontSize="11" FontWeight="SemiBold" Foreground="#1F2329"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <primitives:Thumb x:Name="MoveThumb" Grid.Column="1" DragDelta="MoveThumb_DragDelta"
                              Cursor="SizeAll" ToolTip="拖动移动提示图标" AutomationProperties.Name="移动 SnapIt 提示图标">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="#EEF1F4" CornerRadius="7" Margin="1,4,1,4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="3" Height="3" Fill="#69727D" Margin="0,1"/>
                                <Ellipse Width="3" Height="3" Fill="#69727D" Margin="0,1"/>
                                <Ellipse Width="3" Height="3" Fill="#69727D" Margin="0,1"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>
