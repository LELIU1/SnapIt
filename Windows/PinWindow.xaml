<Window x:Class="SnapIt.Windows.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapIt 贴图" WindowStyle="None" AllowsTransparency="True"
        Background="White" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="取消置顶并关闭" Click="Unpin_Click"/>
            <MenuItem Header="拖动移动 · 滚轮缩放 · 双击或 Esc 关闭" IsEnabled="False"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border BorderBrush="#88000000" BorderThickness="1" CornerRadius="2">
        <Grid>
            <Image x:Name="PinImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Button x:Name="UnpinButton" Content="取消置顶 ×" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="4" Padding="8,4" Visibility="Collapsed" Click="Unpin_Click"
                    Background="#F2FFFFFF" Foreground="#1F2329" BorderBrush="#B8C0CC"
                    ToolTip="取消置顶并关闭贴图（Esc 或双击也可关闭）"
                    AutomationProperties.Name="取消置顶并关闭贴图"/>
        </Grid>
    </Border>
</Window>
